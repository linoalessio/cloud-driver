<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.lino.cloud.platform</groupId>
        <artifactId>cloud-driver-platform</artifactId>
        <version>1.0.1</version>
    </parent>

    <groupId>de.lino.cloud.platform.app</groupId>
    <artifactId>cloud-driver-platform-app</artifactId>
    <packaging>jar</packaging>

    <properties>
        <javafx.version>21.0.4</javafx.version>
    </properties>

    <dependencies>

        <!-- MainApp/LoginController/FileListController: the JavaFX UI itself.
             javafx-controls pulls in javafx-graphics/javafx-base transitively. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>

        <!-- ApiClient: hand-parses the REST API's JSON request/response bodies (Dtos). -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- `java -jar`/plain classpath launch of a class that itself extends
                 javafx.application.Application is rejected by the JVM ("JavaFX runtime
                 components are missing") - JavaFX intentionally requires module-path/
                 add-modules JVM flags, which this plugin computes from the javafx-controls
                 dependency above and passes at launch. Run via
                 `mvn -pl cloud-driver-platform/cloud-driver-platform-app -am javafx:run`. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>de.lino.cloud.platform.app.MainApp</mainClass>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- javafx-controls has no OS-independent jar on Maven Central - each platform's native
         bits ship under their own classifier. Pick it from the build machine's own OS, the same
         way every javafx-maven-plugin-based project does, since this module has no os-maven-plugin
         dependency to detect it automatically. -->
    <profiles>
        <profile>
            <id>javafx-platform-mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-platform-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-platform-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>
    </profiles>

</project>
