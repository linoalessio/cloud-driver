<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>de.lino.cloud</groupId>
        <artifactId>cloud-driver</artifactId>
        <version>1.0.0</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <groupId>de.lino.cloud.bootstrap</groupId>
    <artifactId>cloud-driver-bootstrap</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <dependency>
            <groupId>de.lino.cloud.plugin</groupId>
            <artifactId>cloud-driver-plugin</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Reads DB credentials/KEK material out of a gitignored "data.env" file instead of
             inline in source; see "Local dev secrets" in CLAUDE.md. -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.2.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- java -jar needs both a Main-Class manifest entry and every dependency
                 (cloud-driver-plugin, database-driver-*, javalin, bcprov, ...) actually on
                 the classpath - plain `mvn package` only produces a thin jar with neither, so
                 this shades everything into one self-contained, runnable jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.lino.cloud.bootstrap.CloudBootstrap</mainClass>
                                </transformer>
                                <!-- Merges META-INF/services entries (e.g. the Postgres JDBC
                                     driver's java.sql.Driver registration) instead of letting
                                     one dependency's copy silently overwrite another's. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <!-- bcprov-jdk18on ships signed; shading it in without
                                         stripping its signature files throws
                                         "Invalid signature file digest" at runtime, since the
                                         merged jar no longer matches what was signed. -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>