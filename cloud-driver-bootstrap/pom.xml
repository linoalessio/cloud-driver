<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>de.lino.cloud</groupId>
        <artifactId>cloud-driver</artifactId>
        <version>1.0.1</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <groupId>de.lino.cloud.bootstrap</groupId>
    <artifactId>cloud-driver-bootstrap</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <dependency>
            <groupId>de.lino.cloud.plugin</groupId>
            <artifactId>cloud-driver-plugin</artifactId>
            <version>1.0.1</version>
        </dependency>

        <!-- AuthService/JwtSigner/JjwtSigner, used directly by startRestApi and
             CreateUserCli - already a transitive dependency of cloud-driver-plugin,
             declared directly too since both classes import it. -->
        <dependency>
            <groupId>de.lino.cloud.auth</groupId>
            <artifactId>cloud-driver-auth</artifactId>
            <version>1.0.1</version>
        </dependency>

        <!-- Not used by any class in this module directly - needed at runtime by
             cloud-driver-extensions-metrics. Every extension jar is unshaded and loaded via
             its own URLClassLoader with a parent-first-delegating parent = this jar's own
             classloader (see ExtensionJarLoader), so an extension's own third-party
             dependencies must already be on this jar's shaded classpath; every other
             extension's dependencies happen to already be satisfied that way (cloud-driver-api/
             -plugin/-auth, Javalin, database-driver-*), but cloud-driver-extensions-metrics is
             the first to need a library nothing else here already pulls in. Version pinned to
             match that module's own pom.xml. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <version>1.13.6</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- java -jar needs both a Main-Class manifest entry and every dependency
                 (cloud-driver-plugin, database-driver-*, javalin, bcprov, ...) actually on
                 the classpath - plain `mvn package` only produces a thin jar with neither, so
                 this shades everything into one self-contained, runnable jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.lino.cloud.bootstrap.CloudBootstrap</mainClass>
                                </transformer>
                                <!-- Merges META-INF/services entries (e.g. the Postgres JDBC
                                     driver's java.sql.Driver registration) instead of letting
                                     one dependency's copy silently overwrite another's. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <!-- bcprov-jdk18on ships signed; shading it in without
                                         stripping its signature files throws
                                         "Invalid signature file digest" at runtime, since the
                                         merged jar no longer matches what was signed. -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>