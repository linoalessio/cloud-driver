<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.lino.cloud</groupId>
        <artifactId>cloud-driver</artifactId>
        <version>1.0.1</version>
    </parent>

    <groupId>de.lino.cloud.plugin</groupId>
    <artifactId>cloud-driver-plugin</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <dependency>
            <groupId>de.lino.cloud.api</groupId>
            <artifactId>cloud-driver-api</artifactId>
            <version>1.0.1</version>
        </dependency>

        <!-- AuthService/JwtSigner, for DefaultRestFactory's JWT-gated constructor
             (see architecture/AUTH_REQUIREMENTS.md) - the Owned marker interface it
             checks for per-user data scoping lives here too. -->
        <dependency>
            <groupId>de.lino.cloud.auth</groupId>
            <artifactId>cloud-driver-auth</artifactId>
            <version>1.0.1</version>
        </dependency>

        <!-- @NonNull on concrete methods across DefaultExtensionFactory/DefaultEventFactory/
             DefaultRestFactory - provided scope since it's only needed at compile time
             (annotation processing), never at runtime. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>de.lino.database</groupId>
            <artifactId>database-driver-api</artifactId>
            <version>1.3.11</version>
        </dependency>

        <!-- Concrete DatabaseProvider/DatabaseSection implementations (JSON file store,
             H2, MySQL, PostgreSQL, MongoDB, ...) that entities are actually persisted through. -->
        <dependency>
            <groupId>de.lino.database</groupId>
            <artifactId>database-driver-plugin</artifactId>
            <version>1.3.11</version>
        </dependency>

        <!-- Argon2id password hashing (SECURITY_REQUIREMENTS.md, section 5: PASSWORDS) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- @NotNull/@Nullable on the public API surface; otherwise only a
             transitive dependency of database-driver-api. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
        </dependency>

        <!-- DefaultRestFactory's HTTP layer - thin routing over Jetty, chosen
             over Spring Boot to match this repo's hand-rolled, no-DI-container
             style (see CLAUDE.md). -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>7.2.3</version>
        </dependency>

        <!-- Javalin logs through SLF4J; without a binding it only warns to stderr. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
        </dependency>

        <!-- Transitive dependency of database-driver-plugin (pulled in for its own
             PostgresDatabaseNotification, de.lino.database.database.sql.postgresql - the former
             PostgresChangeNotifier, now living upstream in database-driver rather than in this
             module). Version pinned to match what 1.3.11 currently resolves transitively. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.7</version>
        </dependency>

        <!-- AwsKmsKeyEncryptionService (security.keys) - the production KMS-backed
             KeyEncryptionService. Not wired in as CloudBootstrap's default; an
             operator opts in explicitly. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kms</artifactId>
            <version>2.46.7</version>
        </dependency>

    </dependencies>

</project>