<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.lino.cloud.platforms</groupId>
        <artifactId>cloud-driver-platforms</artifactId>
        <version>1.0.1</version>
    </parent>

    <groupId>de.lino.cloud.platforms.desktop</groupId>
    <artifactId>cloud-driver-platforms-desktop</artifactId>
    <packaging>jar</packaging>

    <properties>
        <kotlin.version>2.0.21</kotlin.version>
        <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
        <kotlinx-coroutines.version>1.9.0</kotlinx-coroutines.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>de.lino.cloud.platforms.rest</groupId>
            <artifactId>cloud-driver-platforms-rest</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <!-- CloudDriverClient's suspend functions are built directly on ApiClient's own
             CompletableFuture-returning *Async methods via kotlinx.coroutines.future.await(),
             rather than reimplementing async HTTP handling in Kotlin. -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
            <version>${kotlinx-coroutines.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-jdk8</artifactId>
            <version>${kotlinx-coroutines.version}</version>
        </dependency>

    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <plugins>
            <!-- Compiles src/main/kotlin ahead of maven-compiler-plugin's own (empty, since there
                 is no src/main/java here) run, matching the standard Kotlin/Maven interop wiring -
                 kotlin-maven-plugin binds to process-sources/process-test-sources itself. -->
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
