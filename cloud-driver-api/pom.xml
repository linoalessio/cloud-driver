<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>de.lino.cloud</groupId>
        <artifactId>cloud-driver</artifactId>
        <version>1.0.1</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <groupId>de.lino.cloud.api</groupId>
    <artifactId>cloud-driver-api</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <dependency>
            <groupId>de.lino.database</groupId>
            <artifactId>database-driver-api</artifactId>
            <version>1.3.12</version>
        </dependency>

        <!-- @NotNull/@Nullable on the public API surface; otherwise only a
             transitive dependency of database-driver-api. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
        </dependency>

        <!-- @NonNull/@Getter/@ToString on domain entities (ApiKey, Event, ExtensionProperties, ...)
             and factory classes (EventFactory, ExtensionFactory) - provided scope since it's only
             needed at compile time (annotation processing), never at runtime. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>

        <!-- Backs de.lino.cloud.api.terminal: raw terminal mode, line editing, tab completion,
             and Ctrl+C/EOF handling for Terminal/ReadingThread - the same "jline" coordinate
             PoloCloud's own cli module depends on. No separate native-provider artifact is
             needed: jline picks its terminal provider at runtime from ffm/jni/exec (verified
             directly against this exact version/JDK combination) - ffm requires JDK 22+ (this
             project targets 21, see the root pom's maven.compiler.target) and is skipped
             automatically, falling through to the JNI-based provider bundled inside this single
             artifact, which opens a real terminal on JDK 21 with no extra dependency. -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>4.3.1</version>
        </dependency>

    </dependencies>

</project>